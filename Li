    RGBLabel.Size = UDim2.new(1, 0, 1, 0)
    RGBLabel.BackgroundTransparency = 1
    RGBLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    RGBLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    RGBLabel.TextStrokeTransparency = 0
    RGBLabel.TextSize = 7.5
    RGBLabel.Font = Enum.Font.GothamBold
    RGBLabel.ZIndex = 52
    RGBLabel.Parent = RGBBox

    local RGBInput = Instance.new("TextBox")
    RGBInput.Size = UDim2.new(1, 0, 1, 0)
    RGBInput.BackgroundTransparency = 0.2
    RGBInput.BackgroundColor3 = Color3.fromRGB(30, 25, 30)
    RGBInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    RGBInput.TextSize = 7.5
    RGBInput.Font = Enum.Font.GothamBold
