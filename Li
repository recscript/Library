-- Mặc định Theme
local CURRENT_THEME = SKINS["Love Moon (hồng)"]
local ThemeColorObjects = {}
local CURRENT_WINDOW = nil
local UpdateMainColorPickerFunc = nil

local function RegisterColorObject(obj, property)
    table.insert(ThemeColorObjects, {Object = obj, Property = property})
    pcall(function() obj[property] = CURRENT_THEME end)
end

local function ApplyTheme(newColor)
    CURRENT_THEME = newColor
    
    for i = #ThemeColorObjects, 1, -1 do
        local item = ThemeColorObjects[i]
        if item.Object and item.Object.Parent then
            pcall(function()
                item.Object[item.Property] = CURRENT_THEME
            end)
        else
            table.remove(ThemeColorObjects, i)
        end
    end

    if CURRENT_WINDOW then
        for _, tab in ipairs(CURRENT_WINDOW.Tabs) do
            if CURRENT_WINDOW.ActiveTab == tab then
                tab.IconImage.ImageColor3 = CURRENT_THEME
                tab.NameLabel.TextColor3 = CURRENT_THEME
                tab.LeftAccent.BackgroundColor3 = CURRENT_THEME
            end
            
            if tab.ActiveSubTab then
                tab.ActiveSubTab.Button.TextColor3 = CURRENT_THEME
            end
        end
    end

    if UI.KeybindItems then
        for name, itemBtn in pairs(UI.KeybindItems) do
            local squareBox = itemBtn:FindFirstChild("SquareBox")
            local innerFill = squareBox and squareBox:FindFirstChild("InnerFill")
            
            if squareBox and innerFill and innerFill.Visible then
                pcall(function()
                    squareBox.BorderColor3 = CURRENT_THEME
                end)
            end
        end
    end

    -- Cập nhật ngay lập tức ô Color Picker bên phải khi đổi Skin
    if UpdateMainColorPickerFunc then
        UpdateMainColorPickerFunc(newColor)
    end
end

