function TabUI:CreateSubTab(subTabName)
    local SubTab = setmetatable({}, SubTabUI)
    
    local SubBtn = Instance.new("TextButton")
    SubBtn.Size = UDim2.new(0, 70, 1, 0)
    SubBtn.BackgroundColor3 = Color3.fromRGB(25, 20, 25)
    SubBtn.BackgroundTransparency = 1
    SubBtn.BorderSizePixel = 0
    SubBtn.Text = subTabName
    SubBtn.TextColor3 = Color3.fromRGB(150, 120, 135)
    SubBtn.TextSize = 9
    SubBtn.Font = Enum.Font.GothamBold
    SubBtn.Parent = self.SubTabScroll

    local function AdjustBtnSize()
        local success, textBounds = pcall(function()
            return game:GetService("TextService"):GetTextSize(subTabName, 9, Enum.Font.GothamBold, Vector2.new(10000, 24))
        end)
        
        if success and textBounds then
            SubBtn.Size = UDim2.new(0, textBounds.X + 16, 1, 0)
        else
            SubBtn.Size = UDim2.new(0, 80, 1, 0)
        end
    end
    AdjustBtnSize()

    local BottomLine = Instance.new("Frame")
    BottomLine.Size = UDim2.new(1, -10, 0, 2)
    BottomLine.Position = UDim2.new(0, 5, 1, -2)
    BottomLine.BorderSizePixel = 0
    BottomLine.Visible = false
    BottomLine.Parent = SubBtn
    RegisterColorObject(BottomLine, "BackgroundColor3")

    local SubTabPage = Instance.new("Frame")
    SubTabPage.Size = UDim2.new(1, 0, 1, 0)
    SubTabPage.BackgroundTransparency = 1
    SubTabPage.Visible = false
    SubTabPage.Parent = self.SubTabContainerFrame

    local function CreateColumn(pos)
        local frame = Instance.new("ScrollingFrame")
        frame.Size = UDim2.new(0.5, -3, 1, 0)
        frame.Position = pos
        frame.BackgroundTransparency = 1
        frame.BorderSizePixel = 0
        frame.ScrollBarThickness = 2
        frame.Parent = SubTabPage
        RegisterColorObject(frame, "ScrollBarImageColor3")
        
        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 6)
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.Parent = frame

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            frame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
        end)
        return frame
    end

    local LeftCol = CreateColumn(UDim2.new(0, 2, 0, 0))
    local RightCol = CreateColumn(UDim2.new(0.5, 3, 0, 0))

    SubTab.Tab = self
    SubTab.Page = SubTabPage
    SubTab.Button = SubBtn
    SubTab.Line = BottomLine
    SubTab.LeftCol = LeftCol
    SubTab.RightCol = RightCol
    SubTab.Elements = {} 

    function SubTab:SwitchToThisSubTab()
        if self.Tab.ActiveSubTab == SubTab then return end

        if self.Tab.ActiveSubTab then
            self.Tab.ActiveSubTab.Page.Visible = false
            self.Tab.ActiveSubTab.Button.TextColor3 = Color3.fromRGB(150, 120, 135)
            self.Tab.ActiveSubTab.Line.Visible = false
        end

        self.Tab.ActiveSubTab = SubTab
        SubTabPage.Visible = true
        SubBtn.TextColor3 = CURRENT_THEME
        BottomLine.Visible = true
        self.Tab.SearchBox.Text = ""
    end

    SubBtn.MouseButton1Click:Connect(function()
        SubTab:SwitchToThisSubTab()
    end)

    table.insert(self.SubTabs, SubTab)

    if #self.SubTabs == 1 then
        SubTab:SwitchToThisSubTab()
    end

    return SubTab
end

