    RowFrame.Parent = target

    local ColorBoxBtn = Instance.new("TextButton")
    ColorBoxBtn.Name = "ColorBoxBtn"
    ColorBoxBtn.Size = UDim2.new(0, 18, 0, 12)
    ColorBoxBtn.Position = UDim2.new(0, 5, 0.5, -6)
    ColorBoxBtn.BackgroundColor3 = currentColor
    ColorBoxBtn.BorderSizePixel = 1
    ColorBoxBtn.AutoButtonColor = false
    ColorBoxBtn.Text = ""
    ColorBoxBtn.Parent = RowFrame

    local function GetDarkerBorder(c)
        local h, s, v = Color3.toHSV(c)
        return Color3.fromHSV(h, s, math.max(0, v - 0.25))
    end
    ColorBoxBtn.BorderColor3 = GetDarkerBorder(currentColor)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -30, 1, 0)
    Label.Position = UDim2.new(0, 28, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(220, 200, 210)
    Label.TextSize = 8
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = RowFrame

    local parentGui = self.SubTab.Tab.Window.ScreenGui
    local PickerFrame, SetPickerColor

    PickerFrame, SetPickerColor = CreateColorPicker(parentGui, currentColor, function(newColor)
        currentColor = newColor
        ColorBoxBtn.BackgroundColor3 = newColor
        ColorBoxBtn.BorderColor3 = GetDarkerBorder(newColor)
        if callback then callback(newColor) end
    end)

    if isMainColor then
        UpdateMainColorPickerFunc = function(newColor)
            currentColor = newColor
            ColorBoxBtn.BackgroundColor3 = newColor
            ColorBoxBtn.BorderColor3 = GetDarkerBorder(newColor)
            SetPickerColor(newColor)
        end
    end

    -- Đã chỉnh vị trí Color Picker mở ở phía dưới góc trái của UI / Button
    ColorBoxBtn.MouseButton1Click:Connect(function()
        PickerFrame.Visible = not PickerFrame.Visible
        if PickerFrame.Visible then
            local mainFrame = self.SubTab.Tab.Window.MainFrame
            local mainPos = mainFrame.AbsolutePosition
            local mainSize = mainFrame.AbsoluteSize
            
            -- Đặt vị trí dưới góc trái của UI chính
            PickerFrame.Position = UDim2.new(0, mainPos.X - 10, 0, mainPos.Y + mainSize.Y - 120)
        end
    end)

    self.SubTab:RegisterElement(text, RowFrame)
end

