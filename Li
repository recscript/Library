function SectionUI:AddSlider(text, min, max, default, callback)
    local target = self.Frame
    local Value = default or min
    
    local SliderFrame = Instance.new("Frame")
    SliderFrame.Size = UDim2.new(0.94, 0, 0, 18)
    SliderFrame.BackgroundColor3 = Color3.fromRGB(30, 22, 28)
    SliderFrame.BorderColor3 = Color3.fromRGB(55, 38, 48)
    SliderFrame.BorderSizePixel = 1
    SliderFrame.Parent = target

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((Value - min) / (max - min), 0, 1, 0)
    Fill.BorderSizePixel = 0
    Fill.Parent = SliderFrame
    RegisterColorObject(Fill, "BackgroundColor3")

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text .. ": " .. Value .. "/" .. max
    Label.TextColor3 = Color3.fromRGB(245, 230, 240)
    Label.TextSize = 8
    Label.Font = Enum.Font.GothamBold
    Label.ZIndex = 3
    Label.Parent = SliderFrame

    local DragBtn = Instance.new("TextButton")
    DragBtn.Size = UDim2.new(1, 0, 1, 0)
    DragBtn.BackgroundTransparency = 1
    DragBtn.Text = ""
    DragBtn.ZIndex = 4
    DragBtn.Parent = SliderFrame
    
    local function SetValue(val)
        Value = math.clamp(val, min, max)
        Label.Text = text .. ": " .. Value .. "/" .. max
        Fill.Size = UDim2.new((Value - min) / (max - min), 0, 1, 0)
        UI.SavedValues[text] = Value
        if callback then callback(Value) end
    end

    local dragging = false
    local function Update(input)
        local posX = math.clamp(input.Position.X - SliderFrame.AbsolutePosition.X, 0, SliderFrame.AbsoluteSize.X)
        local posRatio = posX / SliderFrame.AbsoluteSize.X
        SetValue(math.floor(min + (max - min) * posRatio))
    end

    DragBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; Update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then Update(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)

    UI.ElementsRegistry[text] = {
        Type = "Slider",
        Set = SetValue
    }
    UI.SavedValues[text] = Value
    
    self.SubTab:RegisterElement(text, SliderFrame)
end

function SectionUI:AddDropdown(text, list, defaultSelected, multi, callback, ignoreSave)
    local target = self.Frame
    local opened = false
    list = list or {"Lựa chọn 1"}
    
    local selected
    if multi then
        selected = (type(defaultSelected) == "table") and defaultSelected or {list[1]}
    else
        selected = defaultSelected or list[1]
    end

    local DropFrame = Instance.new("Frame")
    DropFrame.Size = UDim2.new(0.94, 0, 0, 18)
    DropFrame.BackgroundColor3 = Color3.fromRGB(30, 22, 28)
    DropFrame.BorderColor3 = Color3.fromRGB(55, 38, 48)
    DropFrame.BorderSizePixel = 1
    DropFrame.ClipsDescendants = true
    DropFrame.Parent = target

    local HeaderBtn = Instance.new("TextButton")
    HeaderBtn.Size = UDim2.new(1, 0, 0, 18)
    HeaderBtn.BackgroundTransparency = 1
    HeaderBtn.Text = ""
    HeaderBtn.Parent = DropFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -20, 1, 0)
    Label.Position = UDim2.new(0, 4, 0, 0)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = Color3.fromRGB(220, 200, 210)
    Label.TextSize = 8
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = HeaderBtn

    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 18, 0, 18)
    Arrow.Position = UDim2.new(1, -18, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "▼"
    Arrow.TextSize = 7
    Arrow.Font = Enum.Font.GothamBold
    Arrow.Parent = HeaderBtn
    RegisterColorObject(Arrow, "TextColor3")

    local ListContainer = Instance.new("ScrollingFrame")
    ListContainer.Size = UDim2.new(1, 0, 1, -18)
    ListContainer.Position = UDim2.new(0, 0, 0, 18)
    ListContainer.BackgroundTransparency = 1
    ListContainer.BorderSizePixel = 0
    ListContainer.ScrollBarThickness = 2
    ListContainer.Parent = DropFrame
    RegisterColorObject(ListContainer, "ScrollBarImageColor3")

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ListLayout.Parent = ListContainer

    local function UpdateText()
        if multi then
            local txt = text .. ": "
            if #selected > 0 then
                txt = txt .. table.concat(selected, ", ")
            else
                txt = txt .. "Chưa chọn"
            end
            Label.Text = txt
        else
            Label.Text = text .. ": " .. tostring(selected)
        end
    end

    local function SetSelection(val)
        selected = val
        if not ignoreSave then
            UI.SavedValues[text] = selected
        end
        UpdateText()
        if callback then callback(selected) end
    end

    UpdateText()

    local function RebuildList()
        for _, ch in pairs(ListContainer:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end

        for _, item in ipairs(list) do
            local ItemBtn = Instance.new("TextButton")
            ItemBtn.Size = UDim2.new(1, 0, 0, 16)
            ItemBtn.BackgroundColor3 = Color3.fromRGB(25, 18, 23)
            ItemBtn.BorderColor3 = Color3.fromRGB(45, 30, 40)
            ItemBtn.BorderSizePixel = 1
            ItemBtn.TextSize = 8
            ItemBtn.Font = Enum.Font.Gotham
            ItemBtn.ZIndex = 5
            ItemBtn.Parent = ListContainer

            local isSelected = false
            if multi then
                for _, v in ipairs(selected) do
                    if v == item then isSelected = true; break end
                end
            else
                isSelected = (selected == item)
            end

            ItemBtn.Text = (isSelected and " ✓ " or "   ") .. tostring(item)
            ItemBtn.TextXAlignment = Enum.TextXAlignment.Left

            if isSelected then
                RegisterColorObject(ItemBtn, "TextColor3")
            else
                ItemBtn.TextColor3 = Color3.fromRGB(180, 150, 170)
            end

            ItemBtn.MouseButton1Click:Connect(function()
                if multi then
                    local found = false
                    for i, v in ipairs(selected) do
                        if v == item then table.remove(selected, i); found = true; break end
                    end
                    if not found then table.insert(selected, item) end
                    SetSelection(selected)
                    RebuildList()
                else
                    opened = false
                    SetSelection(item)
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(0.94, 0, 0, 18)}):Play()
                    Arrow.Text = "▼"
                end
            end)
        end
        ListContainer.CanvasSize = UDim2.new(0, 0, 0, #list * 16)
    end

    HeaderBtn.MouseButton1Click:Connect(function()
        opened = not opened
        Arrow.Text = opened and "▲" or "▼"
        local targetH = opened and math.min(120, (#list * 16) + 18) or 18
        TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(0.94, 0, 0, targetH)}):Play()
        if opened then RebuildList() end
    end)

    if not ignoreSave then
        UI.ElementsRegistry[text] = {
            Type = "Dropdown",
            Set = SetSelection
        }
        UI.SavedValues[text] = selected
    end

    local DropObject = {
        Frame = DropFrame,
        UpdateList = function(newList)
            list = newList
            selected = list[1] or "Chưa có"
            UpdateText()
            RebuildList()
        end
    }

    self.SubTab:RegisterElement(text, DropFrame)
    return DropObject
end

