        local newColor = Color3.fromHSV(h, s, v)
        SatValBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        HexBox.BackgroundColor3 = newColor
        RGBBox.BackgroundColor3 = newColor
        Stroke.Color = newColor

        local r = math.floor(newColor.R * 255)
        local g = math.floor(newColor.G * 255)
        local b = math.floor(newColor.B * 255)

        HexLabel.Text = "#" .. newColor:ToHex():upper()
        RGBLabel.Text = string.format("(%d, %d, %d)", r, g, b)

        if onColorChanged and not skipCallback then
            onColorChanged(newColor)
        end
    end

    SetColorFromExternal = function(newColor)
        h, s, v = Color3.toHSV(newColor)
        Cursor.Position = UDim2.new(s, 0, 1 - v, 0)
        HueCursor.Position = UDim2.new(0.5, 0, h, 0)
        UpdateColor(true)
    end

    UpdateColor()

    HexBox.MouseButton1Click:Connect(function()
        HexInput.Text = HexLabel.Text
        HexInput.Visible = true
        HexInput:CaptureFocus()
    end)

    HexInput.FocusLost:Connect(function(enterPressed)
        HexInput.Visible = false
        if enterPressed then
            local success, newColor = pcall(function()
                return Color3.fromHex(HexInput.Text)
            end)
            if success and newColor then
                SetColorFromExternal(newColor)
                if onColorChanged then onColorChanged(newColor) end
            end
        end
    end)

    RGBBox.MouseButton1Click:Connect(function()
        local r = math.floor(Color3.fromHSV(h, s, v).R * 255)
        local g = math.floor(Color3.fromHSV(h, s, v).G * 255)
        local b = math.floor(Color3.fromHSV(h, s, v).B * 255)
        RGBInput.Text = string.format("%d, %d, %d", r, g, b)
        RGBInput.Visible = true
        RGBInput:CaptureFocus()
    end)

    RGBInput.FocusLost:Connect(function(enterPressed)
        RGBInput.Visible = false
        if enterPressed then
            local r, g, b = RGBInput.Text:match("(%d+)%D+(%d+)%D+(%d+)")
            if r and g and b then
                local newColor = Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
                SetColorFromExternal(newColor)
                if onColorChanged then onColorChanged(newColor) end
            end
        end
    end)

    local draggingSatVal = false
    local function UpdateSatVal(input)
        local pos = input.Position
        local boxPos = SatValBox.AbsolutePosition
        local boxSize = SatValBox.AbsoluteSize
        s = math.clamp((pos.X - boxPos.X) / boxSize.X, 0, 1)
        v = 1 - math.clamp((pos.Y - boxPos.Y) / boxSize.Y, 0, 1)
        Cursor.Position = UDim2.new(s, 0, 1 - v, 0)
        UpdateColor()
    end

    SatValBox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSatVal = true
            UpdateSatVal(input)
        end
    end)

    local draggingHue = false
    local function UpdateHue(input)
        local pos = input.Position
        local boxPos = HueSlider.AbsolutePosition
        local boxSize = HueSlider.AbsoluteSize
        h = math.clamp((pos.Y - boxPos.Y) / boxSize.Y, 0, 1)
        HueCursor.Position = UDim2.new(0.5, 0, h, 0)
        UpdateColor()
    end

    HueSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            UpdateHue(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSatVal then UpdateSatVal(input)
            elseif draggingHue then UpdateHue(input) end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSatVal = false
            draggingHue = false
        end
    end)

    return Frame, SetColorFromExternal
end

