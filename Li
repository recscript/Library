local function GetNotifContainerSettings(posType)
    if posType == "Phải dưới" then
        return UDim2.new(1, -20, 1, -20), Vector2.new(1, 1), Enum.VerticalAlignment.Bottom
    elseif posType == "Phải trên" then
        return UDim2.new(1, -20, 0, 20), Vector2.new(1, 0), Enum.VerticalAlignment.Top
    elseif posType == "Trái dưới" then
        return UDim2.new(0, 20, 1, -20), Vector2.new(0, 1), Enum.VerticalAlignment.Bottom
    elseif posType == "Trái trên" then
        return UDim2.new(0, 20, 0, 20), Vector2.new(0, 0), Enum.VerticalAlignment.Top
    else
        return UDim2.new(0.5, 0, 0.62, 0), Vector2.new(0.5, 0), Enum.VerticalAlignment.Top
    end
end

local function SendNotificationGlobal(text, duration)
    duration = duration or 3
    
    local parentGui
    if gethui and gethui():FindFirstChild("PinkMiniHub") then
        parentGui = gethui():FindFirstChild("PinkMiniHub")
    elseif CoreGui:FindFirstChild("PinkMiniHub") then
        parentGui = CoreGui:FindFirstChild("PinkMiniHub")
    elseif game.Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("PinkMiniHub") then
        parentGui = game.Players.LocalPlayer.PlayerGui:FindFirstChild("PinkMiniHub")
    end

    if not parentGui then return end

    local posUDim, anchor, verticalAlign = GetNotifContainerSettings(UI.NotifPosition)

    local NotifContainer = parentGui:FindFirstChild("NotificationContainer")
    if not NotifContainer then
        NotifContainer = Instance.new("Frame")
        NotifContainer.Name = "NotificationContainer"
        NotifContainer.Size = UDim2.new(0, 200, 0, 300)
        NotifContainer.Position = posUDim
        NotifContainer.AnchorPoint = anchor
        NotifContainer.BackgroundTransparency = 1
        NotifContainer.ZIndex = 100
        NotifContainer.Parent = parentGui

        local NotifLayout = Instance.new("UIListLayout")
        NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
        NotifLayout.VerticalAlignment = verticalAlign
        NotifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        NotifLayout.Padding = UDim.new(0, 4)
        NotifLayout.Parent = NotifContainer
    else
        NotifContainer.Position = posUDim
        NotifContainer.AnchorPoint = anchor
        local layout = NotifContainer:FindFirstChildOfClass("UIListLayout")
        if layout then
            layout.VerticalAlignment = verticalAlign
        end
    end

    notifCounter = notifCounter + 1

    local Toast = Instance.new("Frame")
    Toast.Name = "ToastNotif"
    Toast.Size = UDim2.new(1, 0, 0, 28)
    Toast.BackgroundColor3 = Color3.fromRGB(15, 10, 12)
    Toast.BorderSizePixel = 1
    Toast.BackgroundTransparency = 1
    Toast.ZIndex = 101
    Toast.LayoutOrder = notifCounter
    Toast.Parent = NotifContainer
    Toast.ClipsDescendants = true
    RegisterColorObject(Toast, "BorderColor3")

    local Desc = Instance.new("TextLabel")
    Desc.Size = UDim2.new(1, -12, 1, -2)
    Desc.Position = UDim2.new(0, 6, 0, 0)
    Desc.BackgroundTransparency = 1
    Desc.Text = text or ""
    Desc.TextSize = 8
    Desc.Font = Enum.Font.GothamMedium
    Desc.TextWrapped = true
    Desc.TextXAlignment = Enum.TextXAlignment.Center
    Desc.TextYAlignment = Enum.TextYAlignment.Center
    Desc.ZIndex = 102
    Desc.Parent = Toast
    RegisterColorObject(Desc, "TextColor3")
    
    local ProgressBarBg = Instance.new("Frame")
    ProgressBarBg.Size = UDim2.new(1, 0, 0, 2)
    ProgressBarBg.Position = UDim2.new(0, 0, 1, -2)
    ProgressBarBg.BackgroundColor3 = Color3.fromRGB(40, 25, 35)
    ProgressBarBg.BorderSizePixel = 0
    ProgressBarBg.ZIndex = 102
    ProgressBarBg.Parent = Toast

    local ProgressBar = Instance.new("Frame")
    ProgressBar.Size = UDim2.new(1, 0, 1, 0)
    ProgressBar.BorderSizePixel = 0
    ProgressBar.ZIndex = 103
    ProgressBar.Parent = ProgressBarBg
    RegisterColorObject(ProgressBar, "BackgroundColor3")

    TweenService:Create(Toast, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.35
    }):Play()
    
    TweenService:Create(ProgressBar, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
        Size = UDim2.new(0, 0, 1, 0)
    }):Play()

    task.delay(duration, function()
        if Toast and Toast.Parent then
            local fadeOut = TweenService:Create(Toast, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                BackgroundTransparency = 1
            })
            
            TweenService:Create(Desc, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
            
            fadeOut:Play()
            fadeOut.Completed:Connect(function()
                Toast:Destroy()
            end)
        end
    end)
end

function UI:SendNotification(a, b, c)
    local msg = type(b) == "string" and b or a
    local dur = type(b) == "number" and b or (type(c) == "number" and c or 3)
    SendNotificationGlobal(msg, dur)
end

function WindowUI:SendNotification(a, b, c)
    local msg = type(b) == "string" and b or a
    local dur = type(b) == "number" and b or (type(c) == "number" and c or 3)
    SendNotificationGlobal(msg, dur)
end

