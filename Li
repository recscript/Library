local function RegisterOrUpdateKeybindItem(name, state, toggleCallback, currentKey)
    if not UI.KeybindContainer then return end

    local existing = UI.KeybindContainer:FindFirstChild(name)
    local keyText = currentKey and (" [" .. currentKey.Name .. "]") or ""
    
    if not existing then
        local ItemBtn = Instance.new("TextButton")
        ItemBtn.Name = name
        ItemBtn.Size = UDim2.new(1, 0, 0, 20)
        ItemBtn.BackgroundColor3 = Color3.fromRGB(26, 20, 25)
        ItemBtn.BorderColor3 = Color3.fromRGB(55, 38, 48)
