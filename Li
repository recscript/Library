            TweenService:Create(SquareBox, TweenInfo.new(0.15), {
                BorderColor3 = state and CURRENT_THEME or Color3.fromRGB(70, 50, 62)
            }):Play()
        end

        if InnerFill then InnerFill.Visible = state end

        if NameLbl then
            NameLbl.Text = name .. keyText
            NameLbl.TextColor3 = state and Color3.fromRGB(240, 220, 230) or Color3.fromRGB(150, 130, 140)
        end
    end
end

