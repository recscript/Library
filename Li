        ItemBtn.Parent = UI.KeybindContainer

        local SquareBox = Instance.new("Frame")
        SquareBox.Name = "SquareBox"
        SquareBox.Size = UDim2.new(0, 12, 0, 12)
        SquareBox.Position = UDim2.new(0, 5, 0.5, -6)
